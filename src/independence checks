using DataFrames, Query
using CSV
using StatsBase
using GLM, MixedModels
using Gadfly
using Cairo
using RCall

data = CSV.read(
  "/Users/ewanwsmith/github/Apodemus_vaccines/data/OD_data.csv";
  missingstrings = ["NA"],
  pool = true,
  copycols = true,
)

lab =
  data |>
  @filter(_.:Env == "Lab") |>
  @dropna(:days_since_1st_D_inj) |>
  DataFrame

@rput lab
R"cor.test(lab$days_since_1st_D_inj, lab$Fat_Scores_Sum)"
R"t.test(lab$days_since_1st_D_inj ~ lab$Diet)"
R"t.test(lab$days_since_1st_D_inj ~ lab$Sex)"
R"chisq.test(lab$Diet, lab$Sex)"
